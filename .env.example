# Application
NODE_ENV=development
PORT=3000

# MongoDB connection string (placeholder - replace with your own)
MONGODB_URI=mongodb://localhost:27017/devops-learning-api

# Comma-separated list of allowed origins, or * to allow all
CORS_ORIGIN=http://localhost:3000

# error | warn | info | http | debug
LOG_LEVEL=info

# Max time (ms) to wait for graceful shutdown before forcing exit
SHUTDOWN_TIMEOUT_MS=10000
